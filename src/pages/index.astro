---
import Layout from "@layouts/Default.astro";
import RecentBlogPosts from "@components/generic/RecentBlogPosts.astro";
import MobileSocials from "@components/home/MobileSocials.astro";
import { Button } from "@eliancodes/brutal-ui";
import { Card } from "@eliancodes/brutal-ui";

---

<Layout title="Home" pageTitle="Home" description="Personal website of Batuhan Teberoglu">
  <main class="bg-[#22d3ee] p-6 *:min-h-full">
    <MobileSocials />
    <section id="about" class="grid md:grid-cols-8 gap-8 mt-4">
      <h2 class="hidden">About me</h2>
      <div class="col-span-4">
        <Card color="white">
          <div class="flex flex-col justify-between items-start md:gap-4">
            <p class="md:mt-4 righteous text-3xl md:text-5xl lg:text-7xl">batuhan teberoğlu</p>
            <p class="mb-4 md:mb-0 md:mt-2 outfit text-2xl md:text-3xl lg:text-5xl">Software Engineer</p>
            <Button target={"_self"} href="/blog/">Check out the blog &rarr;</Button>
          </div>
        </Card>
      </div>
      <div class="col-span-4 lg:col-span-2 space-y-4">
        <Card color="white">
          <h2 class="outfit font-bold text-xl md:text-2xl lg:text-3xl">Who am I?</h2>
          <p class="text-lg md:text-xl leading-relaxed mt-4">
            I'm a software engineer who loves building digital experiences that matter. 
            When I'm not coding, you'll find me exploring new technologies, contributing to 
            open source, or wandering around Ankara with my camera.
          </p>
          <p class="text-lg md:text-xl leading-relaxed mt-3">
            I believe in clean code, thoughtful design, and the power of technology to 
            solve real problems. Currently crafting solutions with modern web technologies 
            and always learning something new.
          </p>
          <p class="text-lg md:text-xl leading-relaxed mt-3 font-medium">
            Let's build something amazing together! 🚀
          </p>
        </Card>
      </div>
      <div class="col-span-4 lg:col-span-2">
        <Card color="white">
          <h2 class="text-2xl md:text-3xl lg:text-4xl mb-4 outfit font-bold text-black text-center">
            That's Me!
          </h2>
          <img class="rounded-xl w-48 h-48 mx-auto object-cover" src="/images/me.jpeg" alt="Batuhan Teberoglu" loading="eager" />
        </Card>
      </div>
    </section>
    
    <section id="additional-content" class="grid md:grid-cols-8 gap-8 mt-8">
      <div class="col-span-8 md:col-span-3">
        <Card color="white">
          <h2 class="outfit font-bold text-xl md:text-2xl lg:text-3xl">Currently Working On</h2>
          <div class="mt-4 space-y-3">
            <p class="text-lg md:text-xl leading-relaxed">
              🚧 <strong>Personal Website v2</strong> - Redesigning my portfolio with Astro and modern UX principles
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              📚 <strong>Learning</strong>: Advanced TypeScript patterns & performance optimization
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              🎯 <strong>Goal</strong>: Contributing more to open source projects and building developer tools
            </p>
          </div>
        </Card>
      </div>
      
      <div class="col-span-8 md:col-span-3">
        <Card color="white">
          <h2 class="outfit font-bold text-xl md:text-2xl lg:text-3xl">Let's Connect!</h2>
          <div class="mt-4 space-y-3">
            <p class="text-lg md:text-xl leading-relaxed">
              📧 <strong>Email Me</strong> - Always open to interesting conversations
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              💼 <strong>Collaborate</strong> - Got a project idea? Let's make it happen
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              ☕ <strong>Coffee Chat</strong> - Love discussing tech, especially in Ankara
            </p>
            <p class="text-lg md:text-xl leading-relaxed font-medium">
              Drop me a line anytime! 📩
            </p>
          </div>
        </Card>
      </div>
      
      <div class="col-span-8 md:col-span-2">
        <Card color="white">
          <h2 class="outfit font-bold text-xl md:text-2xl lg:text-3xl">Fun Facts</h2>
          <div class="mt-4 space-y-3">
            <p class="text-lg md:text-xl leading-relaxed">
              ☕ <strong>Coffee</strong>: 3 cups minimum for optimal coding
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              📚 <strong>Books</strong>: Always reading something tech-related
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              🥾 <strong>Hiking</strong>: Weekend trails around Ankara
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              🎮 <strong>Gaming</strong>: Strategy games for problem-solving
            </p>
          </div>
        </Card>
      </div>
    </section>
    
    <RecentBlogPosts />
  </main>
</Layout>
